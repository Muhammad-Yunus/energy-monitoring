# Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# Database
DATABASE_URL=postgres://energy:change-me@127.0.0.1:5432/energy_monitoring
POSTGRES_DB=energy_monitoring
POSTGRES_USER=energy
POSTGRES_PASSWORD=change-me

# Object storage (RustFS)
S3_INTERNAL_ENDPOINT=http://127.0.0.1:9000
S3_PUBLIC_ENDPOINT=http://192.168.1.112:9000
S3_REGION=us-east-1
S3_BUCKET=recordings
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=change-me
S3_FORCE_PATH_STYLE=true

# Auth and seed
SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=admin@demo.local
ADMIN_PASSWORD=change-me
# Token device: em_ diikuti 64 karakter hex
EDGE_SERIAL=EDGE-001
EDGE_TOKEN=em_replace_with_64_hex_characters

# Retention and limits
VIDEO_RETENTION_DAYS=7
VIDEO_MAX_BYTES=1610612736
MAX_VIDEO_BYTES=5242880
MAX_VIDEO_DURATION_MS=30000
READING_RETENTION_DAYS=30
EVENT_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=90
UPLOAD_RETENTION_DAYS=1
DEVICE_OFFLINE_SECONDS=30
STORAGE_WARN_PCT=80
MIN_FREE_DISK_BYTES=1073741824

# Backup
BACKUP_DIR=./backups
BACKUP_KEEP=7

# App and simulator
NUXT_PUBLIC_APP_URL=http://192.168.1.112:3000
API_URL=http://127.0.0.1:3000
